{
  "name": "accounting",
  "version": "1.0.0",
  "description": "ERP Accounting & Finance - Django Admin",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind",
    "build:clean": "rimraf ../static/css/dist",
    "build:tailwind": "cross-env NODE_ENV=production tailwindcss --postcss --minify -i ./css/styles.css -o ../static/css/dist/styles.css",
    "dev": "cross-env NODE_ENV=development tailwindcss --postcss -i ./css/styles.css -o ../static/css/dist/styles.css -w"
  }
}
